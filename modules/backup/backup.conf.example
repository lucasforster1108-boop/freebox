# ============================================================
# backup.conf 配置模板
# 使用方法: 把本文件复制为 backup.conf，再按注释改成你自己的值
# cp backup.conf.example backup.conf
# ============================================================

# 要备份的目录，可以写多个，每行一个，用引号括起来
# 注意: 不要把脚本的临时工作目录（WORK_DIR，默认 /tmp/vps-backup-work）放进来
SOURCE_DIRS=(
"/etc"
"/var/www/html"
"/path/to/your-app/data"
)

# rclone 的 remote 名称
# 必须和你在 rclone config 里创建的名字一模一样
# 查看已有 remote: 在终端执行 rclone listremotes
REMOTE_NAME="mydrive"

# 网盘上存放备份的目录（不存在会自动创建）
# 每份备份会在这里再建一个 backup-日期时间 的子文件夹
REMOTE_PATH="backups/my-server"

# 只保留最近几份备份，更早的自动删除。默认 4
KEEP_COUNT=4

# 单个文件超过这个大小就自动切成小块再上传。默认 400M
# 可写 400M / 2G / 500K，或直接写字节数如 419430400
# 为什么要分块，见 README 的「常见问题」第 1 条
SPLIT_SIZE="400M"

# 本地临时工作目录：打包和分块先在这里进行，跑完自动清理
# 本地磁盘要预留至少「源数据压缩后大小」的空闲空间，不够就改到大磁盘
# WORK_DIR="/tmp/vps-backup-work"

# 日志目录，默认是脚本所在目录下的 logs 文件夹
# LOG_DIR="/path/to/backup-logs"
