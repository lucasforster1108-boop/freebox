# FreeBox configuration. Copy to config.env and fill in YOUR values.
# Nothing in this file is secret by itself except tokens — keep config.env
# out of git (it is in .gitignore).

# Your domain (used by the tunnel module for hostnames)
DOMAIN=example.com

# Server timezone, e.g. Asia/Shanghai, Europe/Berlin, UTC
TZ=UTC

# Telegram alerts (optional, used by monitor/backup notes):
# create a bot with @BotFather, then get your chat id from @userinfobot
TG_BOT_TOKEN=
TG_CHAT_ID=

# SubHub subscription token. Leave empty to auto-generate on install.
# Treat the resulting subscription URL like a password.
SUB_TOKEN=
